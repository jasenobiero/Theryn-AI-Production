# Shared runtime config
NODE_ENV=production
PORT=3000
BASE_PATH=/
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/theryn
CORS_ALLOWED_ORIGINS=https://theryn.dev

# Clerk
CLERK_SECRET_KEY=sk_live_your_clerk_secret
CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
VITE_CLERK_PROXY_URL=https://theryn.dev/api/__clerk
ISSUER_URL=https://replit.com/oidc

# AI providers
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-key
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=your-anthropic-key
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=your-openrouter-key
ELEVENLABS_API_KEY=your-elevenlabs-key

# PayPal credentials belong only on the API server. Never use VITE_ prefixes.
APP_BASE_URL=https://theryn.dev
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=THERYN AI <updates@theryn.dev>
FEATURE_ANNOUNCEMENT_ADMIN_TOKEN=replace-with-a-long-random-admin-token
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-rest-app-client-id
PAYPAL_CLIENT_SECRET=your-paypal-rest-app-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_PLAN_ID_PLUS=your-paypal-plus-monthly-plan-id
PAYPAL_PLAN_ID_PRO=your-paypal-pro-monthly-plan-id
PAYPAL_PLAN_ID_ULTRA=your-paypal-ultra-monthly-plan-id

# Bot service
THERYN_API_URL=https://theryn.dev
THERYN_BOT_API_TOKEN=replace-with-a-shared-bot-secret
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

