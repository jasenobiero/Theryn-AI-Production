{
  "name": "theryn-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-07",
  "vars": {
    "API_ORIGIN": "https://theryn-ai-production-production.up.railway.app"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./artifacts/ai-hub/dist/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}